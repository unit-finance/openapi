source 'https://rubygems.org'

# Resolve the freshly-generated SDK gem from the SDK root (one level up from
# this spec/ dir). This pulls in the gem's runtime dependency (typhoeus) and
# its development dependency (rspec) straight from the gemspec, so the test
# loop installs exactly what the SDK declares.
gemspec path: '..', name: 'unit_openapi_ruby_sdk'

# `.env` loading for the sandbox credentials convention (see spec_helper.rb).
gem 'dotenv', '~> 3.1'
