# Bearer JWT for the Unit sandbox (https://api.s.unit.sh).
# Tests are skipped automatically when this is unset, so dev machines
# without sandbox credentials can still run `npm run test:sdk:java`.
#
# ApiSupport loads the nearest `.env` found by walking up from the working
# directory. Real environment variables always take precedence over `.env`.
#
#   - In-repo dev loop: create `templates/java/.env` (git-ignored).
#     `place-java-tests` copies it to the SDK root so the runner finds it, and
#     it survives regeneration because it lives outside the wiped output tree.
#   - Standalone SDK: drop a `.env` next to `pom.xml`.
UNIT_SANDBOX_TOKEN=

# Optional override; defaults to the spec's server URL.
# UNIT_SANDBOX_BASE_URL=https://api.s.unit.sh
